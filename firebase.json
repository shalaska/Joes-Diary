{
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules"
    },
    "emulators": {
        "firestore": {
            "port": 8080
        },
        "singleProjectMode": true
    },
    "functions": [
        {
            "source": "gateway",
            "codebase": "gateway",
            "ignore": [
                "node_modules",
                "**/*.test.js"
            ]
        }
    ]
}
