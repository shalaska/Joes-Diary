{
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/mcp",
                "function": {
                    "functionId": "mcp",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/oauth/**",
                "function": {
                    "functionId": "mcp",
                    "region": "europe-west1"
                }
            },
            {
                "source": "/.well-known/**",
                "function": {
                    "functionId": "mcp",
                    "region": "europe-west1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules"
    },
    "emulators": {
        "firestore": {
            "port": 8080
        },
        "singleProjectMode": true
    },
    "functions": [
        {
            "source": "gateway",
            "codebase": "gateway",
            "ignore": [
                "node_modules",
                "**/*.test.js"
            ]
        }
    ]
}
